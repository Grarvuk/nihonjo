# -----------------------------------------------------------------------------
# Configuration globale Nihonjo
# -----------------------------------------------------------------------------

# Définir le comportement par défaut : Git gère les fins de lignes automatiquement
* text=auto

# -----------------------------------------------------------------------------
# Encodage UTF-8 forcé pour préserver les Kanjis/Kanas
# -----------------------------------------------------------------------------

*.html text eol=lf working-tree-encoding=UTF-8
*.js   text eol=lf working-tree-encoding=UTF-8
*.css  text eol=lf working-tree-encoding=UTF-8
*.json text eol=lf working-tree-encoding=UTF-8
*.md   text eol=lf working-tree-encoding=UTF-8
*.php  text eol=lf working-tree-encoding=UTF-8
*.mjs  text eol=lf working-tree-encoding=UTF-8
# Fichiers de commandes Windows : CRLF obligatoire, sinon cmd.exe saute des lignes
# (les etiquettes « :xxx » et les « goto » se lisent mal avec des fins LF).
*.bat  text eol=crlf

# -----------------------------------------------------------------------------
# Gestion des fichiers binaires (images, icônes)
# -----------------------------------------------------------------------------

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.sqlite binary

# -----------------------------------------------------------------------------
# Cas particuliers
# -----------------------------------------------------------------------------

# Empêcher Git de modifier les fins de lignes dans certains fichiers si nécessaire
.gitignore text eol=lf